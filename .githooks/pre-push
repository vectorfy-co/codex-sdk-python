#!/bin/sh
set -eu

if [ "${SKIP_PRE_PUSH_CI:-0}" = "1" ]; then
  echo "Skipping pre-push CI checks because SKIP_PRE_PUSH_CI=1."
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if command -v python3 >/dev/null 2>&1; then
  exec python3 scripts/run_ci_checks.py
fi

exec python scripts/run_ci_checks.py
